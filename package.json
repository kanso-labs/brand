{
  "name": "brand",
  "version": "0.0.0",
  "private": true,
  "description": "Kanso Labs' brand assets and the brand.kansolabs.org page",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kanso-labs/brand.git"
  },
  "scripts": {
    "build": "react-router build && node scripts/site.mjs",
    "compose": "node scripts/compose.mjs",
    "dev": "react-router dev",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "npm run format:check && npm run typecheck",
    "preview": "node scripts/site.mjs --preview",
    "render": "node scripts/render.mjs",
    "typecheck": "react-router typegen && tsc"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@react-router/dev": "8.5.3",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "26.6.11",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "fflate": "0.8.3",
    "oxfmt": "0.80.0",
    "typescript": "7.0.2",
    "vite": "8.4.0"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "5.3.0",
    "@fontsource-variable/roboto-mono": "5.3.0",
    "@fontsource-variable/roboto-serif": "5.3.0",
    "@kanso-labs/kanso-ui": "0.52.0",
    "isbot": "5.2.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.3"
  }
}
